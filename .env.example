# =====================================================================
# 环境变量模板（ Docker Compose 跨平台部署）
# 用法：复制为 .env 并填入真实值；.env 严禁提交代码仓库。
# 切换部署目标（群晖 NAS / 通用 Linux 服务器）只需修改 DATA_ROOT 等路径项。
# =====================================================================

# ---------------------------------------------------------------------
# 宿主机数据根目录（MySQL / Redis / 日志 / 附件统一存放于此）
# ---------------------------------------------------------------------
# 群晖 Synology NAS 示例
DATA_ROOT=/volume1/docker/ticket-system/data
# 通用 Linux 服务器示例（二选一，保留实际使用的一行）
# DATA_ROOT=/opt/ticket-system/data

# 数据库备份输出目录（：不能与生产库放在同一逻辑位置）
BACKUP_DIR=/volume1/backups/ticket-system
# BACKUP_DIR=/var/backups/ticket-system

# ---------------------------------------------------------------------
# MySQL（ MySQL 8.0，utf8mb4）
# ---------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ticket_system
MYSQL_USERNAME=root
# 必填：强密码，长度 >= 16 位
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ---------------------------------------------------------------------
# Redis（临时锁 / 登录失败计数 / 限流计数器，  ）
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------------------------------------------------------------
# 应用与安全
# ---------------------------------------------------------------------
SERVER_PORT=8080
WEB_PORT=80
SPRING_PROFILES_ACTIVE=prod

# 必填：JWT 签名密钥，长度 >= 32 字节的强随机串
# 生成示例（PowerShell）：[Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=

# 生产 HTTPS 必须为 true（ Secure Cookie）
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# 跨域允许来源；生产由 Nginx 同源代理，留空表示不开启跨域
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# 初始超级管理员（：禁止硬编码默认密码）
#
# 推荐做法：**留空** —— 部署后打开系统会自动跳到「初始化向导 /setup」，
#           由你现场设定超管账号名与密码（此后不可修改、不可被重置）。
#
# 仅当需要「无人值守自动建号」（自动化部署）时，才同时填下面两项；
# 只填其中一项不会建号（系统会继续走初始化向导）。
# ⚠️ 账号名不再固定为 administrator：由你决定（允许字母/数字/._-，3~32 位）。
# ---------------------------------------------------------------------
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_DISPLAY_NAME=超级管理员
SUPER_ADMIN_INIT_PASSWORD=

# ---------------------------------------------------------------------
# 反向代理（仅当部署在 Nginx / 群晖反代之后才需要填）
# 填代理**自己的**地址（不是整个内网段），否则任何内网客户端都能伪造
# X-Forwarded-For 绕过 IP 限流。同机代理填 127.0.0.1/32。
# ---------------------------------------------------------------------
TRUSTED_PROXIES=

# ---------------------------------------------------------------------
# 演示数据（仅 dev profile 有意义；生产保持 false）
#   DEMO_USER_INIT_PASSWORD：演示/测试员工的统一初始口令（**不再有默认值**，
#   本地开发请显式设置，如 DevDemo@2026）。留空则不创建演示员工。
#   APP_PROD_INIT：生产初始化清库开关，**一次性**。首次上线若库里带演示数据，
#   置 true 启动一次即可清空；完成后自动落标记，再次启动不会重跑。
# ---------------------------------------------------------------------
DEMO_DATA_ENABLED=true
DEMO_USER_INIT_PASSWORD=
DEMO_APPLY_CONFIG_ENABLED=false
APP_PROD_INIT=false

# ---------------------------------------------------------------------
# 内部通道密钥（备份失败告警 / 主备心跳上报；脚本 → 应用，无用户会话）
# 留空 = 关闭该通道（fail-closed）。建议与 JWT_SECRET 同规格的随机串。
# ---------------------------------------------------------------------
INTERNAL_ALERT_TOKEN=

# ---------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------
LOG_PATH=./logs
LOG_MAX_HISTORY=90
LOG_MAX_FILE_SIZE=50MB
LOG_TOTAL_SIZE_CAP=5GB
