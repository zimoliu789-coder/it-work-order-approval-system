{
  "$comment": [
    "M4a 前后端流程校验器「共享金样例」。",
    "",
    "为什么需要它：后端 FlowDefinitionValidator 首错即抛、前端 validateFlowForPublish 返回全部问题，",
    "两侧规则各自演化，漂移一旦发生（一端放过/一端拦下）只有在生产上才暴露。",
    "把「同一份流程定义 + 期望被指出的问题关键片段」固化成语言无关的 JSON，",
    "后端 JUnit 与前端 Vitest 各自加载同一文件、各自调用本侧校验器、对同一张表断言 ——",
    "任何一端改了规则而另一端没跟上，测试立刻变红。",
    "",
    "匹配语义：expectedProblems 里每项是一段「应当出现的关键子串」（contains 匹配），",
    "而不是逐字文案。理由：两端的文案本来就允许存在无害差异",
    "（如后端 '1..720 小时' vs 前端 '1~720 小时'）；真正致命的是「同一个问题一端报了另一端没报」。",
    "另外用 expectExactCount=true 的用例额外断言问题条数，用于对齐全量收集语义。"
  ],
  "formFields": [
    { "key": "amount", "label": "金额", "type": "NUMBER" },
    { "key": "title", "label": "标题", "type": "TEXT" },
    { "key": "receiver", "label": "接收人", "type": "USER" },
    { "key": "remark", "label": "备注", "type": "MULTI_SELECT" }
  ],
  "samples": [
    {
      "id": "valid-regression-flow",
      "desc": "Wave1 基准流程：主管审批 → 金额判断（>5000 财务复核 / else 归档）→ 结束，分支汇合",
      "expectExactCount": true,
      "expectedProblems": [],
      "definition": {
        "start": "n1",
        "nodes": [
          {
            "key": "n1", "type": "APPROVAL", "name": "主管审批", "signType": "ANY_SIGN", "next": "c1",
            "approverRules": [{ "type": "ROLE", "roleCode": "admin" }]
          },
          {
            "key": "c1", "type": "CONDITION", "name": "金额判断",
            "branches": [
              {
                "key": "b1", "name": "金额大于5000", "next": "n2",
                "condition": { "logic": "AND", "rules": [{ "field": "amount", "op": "GT", "value": 5000 }] }
              },
              { "key": "b2", "name": "其它情况", "next": "n3", "else": true }
            ]
          },
          {
            "key": "n2", "type": "APPROVAL", "name": "财务复核", "signType": "ALL_SIGN", "next": "n3",
            "approverRules": [{ "type": "APPLICANT_CHOOSE", "scope": "ALL", "minCount": 1, "maxCount": 2 }]
          },
          {
            "key": "n3", "type": "APPROVAL", "name": "归档确认", "signType": "ANY_SIGN", "next": "end",
            "approverRules": [{ "type": "FORM_USER_FIELD", "fieldKey": "receiver" }]
          },
          { "key": "end", "type": "END", "name": "结束" }
        ]
      }
    },
    {
      "id": "valid-wave2-flow",
      "desc": "Wave2 全要素：时限审批 → 抄送 → 条件 → 直属领导（时限）→ PREV_ASSIGN → 结束",
      "expectExactCount": true,
      "expectedProblems": [],
      "definition": {
        "start": "n1",
        "nodes": [
          {
            "key": "n1", "type": "APPROVAL", "name": "部门负责人审批", "signType": "ANY_SIGN",
            "next": "cc1", "timeLimitHours": 24,
            "approverRules": [{ "type": "ROLE", "roleCode": "admin" }]
          },
          {
            "key": "cc1", "type": "CC", "name": "抄送管理员", "next": "c1",
            "approverRules": [{ "type": "ROLE", "roleCode": "admin" }]
          },
          {
            "key": "c1", "type": "CONDITION", "name": "金额判断",
            "branches": [
              {
                "key": "b1", "name": "金额大于5000", "next": "n2",
                "condition": { "logic": "AND", "rules": [{ "field": "amount", "op": "GT", "value": 5000 }] }
              },
              { "key": "b2", "name": "其它情况", "next": "n3", "else": true }
            ]
          },
          {
            "key": "n2", "type": "APPROVAL", "name": "直属领导审批", "signType": "ANY_SIGN",
            "next": "n3", "timeLimitHours": 48,
            "approverRules": [{ "type": "LEADER" }]
          },
          {
            "key": "n3", "type": "APPROVAL", "name": "上一节点指定的审批人", "signType": "ANY_SIGN", "next": "end",
            "approverRules": [{ "type": "PREV_ASSIGN", "assignCount": 2 }]
          },
          { "key": "end", "type": "END", "name": "结束" }
        ]
      }
    },
    {
      "id": "empty-definition",
