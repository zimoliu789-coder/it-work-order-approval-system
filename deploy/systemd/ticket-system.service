# =====================================================================
# systemd 单元：Linux 服务器开机自启 / 异常重启（规范 §30）
#
# 安装步骤（以 /opt/ticket-system 为例）：
#   sudo cp deploy/systemd/ticket-system.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ticket-system
#
# 常用命令：
#   sudo systemctl status ticket-system     查看状态
#   sudo systemctl restart ticket-system    重启全部服务
#   journalctl -u ticket-system -n 100      查看启动日志
#
# 说明：
#   - 用 oneshot + RemainAfterExit 而不是 simple：
#     `docker compose up -d` 本身会立刻返回，容器的存活由 Docker 的
#     restart: unless-stopped 策略接管。systemd 只负责「把编排拉起来 / 停下来」。
#   - WorkingDirectory 必须是 deploy 目录（.env 与 docker-compose.yml 都在这里），
#     换了部署路径请同步修改下方两处路径。
# =====================================================================

[Unit]
Description=企业内部设备借用工单系统 (Docker Compose)
Documentation=file:/opt/ticket-system/deploy/README.md
# docker.service 必须先就绪；network-online 用于等待网络可用（镜像拉取/端口绑定都需要）
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ticket-system/deploy

# 按依赖顺序拉起全部服务（compose 内部已声明 depends_on 健康条件）
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# 停止时保留数据卷（数据在 DATA_ROOT，本就不在卷里，这里只是养成显式清理的好习惯）
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart

# 镜像构建可能耗时较长（NAS / 小内存服务器上首次构建尤其明显），
# 置 0 表示不因超时被杀；仅对 Type=oneshot 有意义
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
