# =====================================================================
# MySQL 主主复制的【共用参数】（两台节点挂同一份）
#
# 为什么把「共用机制」与「节点身份」拆成两个文件：
#   本文件承载复制机制（打开 binlog、启用 GTID、选行格式），两台完全一样；
#   身份差异（server-id、自增偏移）放在 node-a.cnf / node-b.cnf。
#   合并成一份会导致「改机制时要在两份文件里改同样两处」，
#   而漏改其中一份的后果是复制静默失效 —— 直到真的需要故障切换时才发现。
#
# 参数依据：MySQL 8.0 官方「Replication」章节 + GTID 前置条件。
# 本文件不含任何密码，可安全提交仓库。
# =====================================================================

[mysqld]

# ---------------- 二进制日志（复制的前提） ----------------
log-bin                       = mysql-bin
# binlog 保留 7 天：给「备机宕机数日后修好」留出追平窗口。
# 过短会导致从节点重新同步失败（relay log 找不到起点）而退化为全量重做。
binlog_expire_logs_seconds    = 604800
max_binlog_size               = 256M

# ROW 格式是 GTID 复制的硬性前提：
# STATEMENT 格式下像 NOW() / UUID() 这类非确定性函数会在主从产生不同结果，
# 而且 GTID 无法为语句级的不确定操作给出正确的事务边界。
binlog_format                 = ROW
# FULL：记录变更前后的完整行镜像。空间换确定性 ——
# 排查主从不一致时能直接从 binlog 看出「改成了什么」，而不只是「改了哪几列」。
binlog_row_image              = FULL

# ---------------- GTID（自动追平的关键） ----------------
# GTID + SOURCE_AUTO_POSITION=1 让从节点按「已执行过哪些事务」定位起点，
# 而不是按 binlog 文件名 + 位点。好处是：备机宕机重启、主节点做过主从切换后，
# 复制都能自动从断点继续，无需人工计算 binlog 位置（这是双主运维中最费神的一步）。
gtid_mode                     = ON
# 拒绝任何无法用 GTID 表达的事务（例如跨引擎的原子性操作），
# 在写入阶段就失败，而不是等到复制断开才暴露
enforce_gtid_consistency      = ON

# 链式复制必须打开：本节点作为从收到的事务，也要写进自己的 binlog，
# 才能再传给对端。主主双向复制若漏此项，会出现「A→B 正常、B 的变更传不回 A」，
# 而 SHOW REPLICA STATUS 却显示两个 Yes —— 属于最难发现的一类配置错误。
# 说明：MySQL 8.0.26+ 用 log_replica_updates；更早版本名为 log_slave_updates。
log_replica_updates           = ON

# ---------------- 中继日志 ----------------
relay_log                     = relay-bin
# 从节点崩溃恢复后自动丢弃不完整的中继日志并重新拉取，避免卡在半截事务上
relay_log_recovery            = ON

# ---------------- 持久性与性能的取舍 ----------------
# 双主场景把两者都设为 1（最严）：这是一套内部系统的写入量，
# 换来的确定性远比那点吞吐重要 —— 复制位置丢失会导致整个切换流程不可信。
sync_binlog                   = 1
innodb_flush_log_at_trx_commit = 1

# ---------------- 复制线程 ----------------
# 并行回放 4 个 worker：工单/审批的消息与节点写入常涉及多表，
# 单线程回放会让备机明显落后于主机，切换时丢掉最后几十秒的数据
replica_parallel_workers      = 4
replica_parallel_type         = LOGICAL_CLOCK
# 提交顺序保持一致，便于按时间点恢复
replica_preserve_commit_order = ON
