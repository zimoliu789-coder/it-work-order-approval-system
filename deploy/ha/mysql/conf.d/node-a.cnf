# =====================================================================
# MySQL 节点身份 · node-a（初始主节点）
#
# 本文件与 node-b.cnf 只有两处不同：server-id 与 auto_increment_offset。
# 由 .env.ha 的 MYSQL_NODE_CONF 选择挂载哪一份（见 docker-compose.ha.yml）。
# =====================================================================

[mysqld]

# 集群内唯一标识。两台相同会导致复制直接拒绝启动（ERROR 1236 系列），
# 且错误信息指向 binlog 而非 server-id，排查时容易跑偏。
server-id = 1

# ---------------- 自增错开（主主复制的防撞机制） ----------------
# auto_increment_increment=2 让两台机的自增值「隔一个取一个」：
#   node-a 取 1,3,5,7…   node-b 取 2,4,6,8…（见各自的 offset）
#
# 为什么需要它：正常运行时只有持有 DB VIP 的一台在写，本不会冲突。
# 但以下两种情况下会出现两边同时写：
#   ① keepalived 发生脑裂（网络分区，两台都认为自己该持有 VIP）；
#   ② 运维人员为排障直连了「非主」那台并写入数据。
# 错开之后，这两类异常最多产生「主键空洞」，而不会产生主键冲突导致复制中断 ——
# 复制一旦因主键冲突中断，就必须人工介入修复数据，代价远大于几个空洞。
auto_increment_increment = 2
auto_increment_offset    = 1
