# =====================================================================
# MySQL 8 生产配置（挂载到容器 /etc/mysql/conf.d/my.cnf）
#
# 本文件**不含任何密码**，可安全提交仓库；
# 口令由 docker-compose 通过 MYSQL_ROOT_PASSWORD 环境变量注入（）。
# =====================================================================

[mysqld]

# ---------------- 字符集（：utf8mb4） ----------------
character-set-server         = utf8mb4
collation-server             = utf8mb4_general_ci
# 中文企业环境：客户端按 utf8mb4 连接，避免 emoji / 生僻字被写成问号
character-set-client-handshake = FALSE

# ---------------- 时区 ----------------
# 与 application.yml 的 serverTimezone=Asia/Shanghai 保持一致。
# 若两侧不一致，工单创建时间、借用到期判定会出现整小时偏移，
# 而这类偏差在界面上看起来完全「正常」，极难被发现。
default-time-zone = '+08:00'

# ---------------- 连接 ----------------
max_connections  = 200
# 禁用反向 DNS 解析：容器网络里 PTR 查询必然失败且要等超时，
# 会让每次新建连接都慢一拍
skip-name-resolve = 1
max_allowed_packet = 64M

# ---------------- InnoDB ----------------
# 群晖等 NAS 内存有限，512M 是「单库内部系统」的保守值。
# 若宿主机内存 ≥ 8G 且并发较高，可上调到 1G~2G（该参数是 MySQL 性能影响最大的一项）。
innodb_buffer_pool_size = 512M
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
# 关键：业务事务常跨多张表（工单 + 设备 + 审批节点 + 消息），
# 锁等待超时给足，避免高并发下直接抛 Lock wait timeout 给用户
innodb_lock_wait_timeout = 50

# ---------------- 慢查询（排查性能问题的唯一线索来源） ----------------
slow_query_log       = 1
slow_query_log_file  = /var/lib/mysql/slow.log
long_query_time      = 2
log_queries_not_using_indexes = 0

# ---------------- 安全 ----------------
# 禁止通过 LOAD DATA LOCAL 读取服务端任意文件（ 安全基线）
local_infile = 0

[client]
default-character-set = utf8mb4
