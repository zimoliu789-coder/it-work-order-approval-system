{
  "name": "ticket-system-frontend",
  "version": "1.1.0",
  "private": true,
  "description": "企业内部设备借用工单系统 - 前端（Vue3 + Vite + TypeScript + Element Plus，单套响应式）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:check": "vite build && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.7.3",
    "html5-qrcode": "^2.3.8",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.6",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "happy-dom": "^14.12.3",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.70.0",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.19"
  }
}
