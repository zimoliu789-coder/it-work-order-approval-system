# =====================================================================
# 生产环境变量（npm run build 时加载）
# 注意：VITE_ 前缀变量会被打包进前端产物，禁止写入任何密钥。
# =====================================================================

# 说明：这里**没有**「应用标题」环境变量 —— 系统名称与 logo 由后端
# GET /api/system/site-info 在运行时下发，可在系统参数页修改并立即全局生效。

# 生产由 Nginx 同源反向代理 /api 到后端，前端只使用相对路径
VITE_API_BASE_URL=/api

# 生产环境必须关闭 Mock：Mock 会暴露硬编码演示账号与明文口令
VITE_USE_MOCK=false
